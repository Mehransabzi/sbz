Options -Indexes

# Canonicalize every request at Apache, before it reaches Passenger.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.sbzpart\.ir$ [NC]
RewriteRule ^ https://sbzpart.ir%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_passenger.c>
PassengerEnabled on
</IfModule>
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/sbzparti/sbz"
PassengerBaseURI "/"
PassengerPython "/home/sbzparti/virtualenv/sbz/3.12/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
