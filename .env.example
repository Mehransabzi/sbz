# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# تنها دسترسی لازم برای اتصال چرتکه
CHORTKE_API_BASE_URL=https://api.chortke.app
CHORTKE_ACCESS_TOKEN=

# قیمت‌های سایت و چرتکه ریال هستند؛ مقدار 1 یعنی بدون تبدیل.
CHORTKE_PRICE_DIVISOR=1
CHORTKE_PAGE_SIZE=100


# کلید GapGPT را از تنظیمات پنل مدیریت وارد کنید.

# Vector search (GapGPT key is managed in the site panel)
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
GAPGPT_PROXY_URL=

# Generate independently for each deployment; never commit a real token.
SBZ_IMAGE_UPLOAD_TOKEN=
